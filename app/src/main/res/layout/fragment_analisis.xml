<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/gris">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:padding="20dp"
        android:orientation="vertical">




        <TextView
            android:layout_width="345dp"
            android:layout_height="match_parent"
            android:text="@string/campoMonto"
            android:textSize="18sp"
            android:textStyle="bold"
            android:fontFamily="@font/noto_serif_lao"
            android:textColor="@color/negro"/>

        <EditText
            android:id="@+id/campoMonto"
            style="@style/EditTextRounded"
            android:layout_width="345dp"
            android:layout_height="55dp"
            android:hint="@string/campoMonto"
            android:inputType="text"
            android:textColor="@color/negro"
            android:textColorHint="@color/gris"
            android:textSize="16sp" />


        <TextView
            android:layout_width="345dp"
            android:layout_height="match_parent"
            android:text="@string/campoTasa"
            android:textSize="18sp"
            android:textStyle="bold"
            android:fontFamily="@font/noto_serif_lao"
            android:layout_marginTop="10dp"
            android:textColor="@color/negro"/>

        <EditText
            android:id="@+id/campoTaza"
            style="@style/EditTextRounded"
            android:layout_width="345dp"
            android:layout_height="55dp"
            android:hint="@string/tasa"
            android:inputType="text"
            android:textColor="@color/negro"
            android:textColorHint="@color/gris"
            android:textSize="16sp"/>


        <TextView
            android:layout_width="345dp"
            android:layout_height="match_parent"
            android:text="@string/campoPlazo"
            android:textSize="18sp"
            android:textStyle="bold"
            android:fontFamily="@font/noto_serif_lao"
            android:layout_marginTop="10dp"
            android:textColor="@color/negro"/>

        <EditText
            android:id="@+id/campoPlazo"
            style="@style/EditTextRounded"
            android:layout_width="345dp"
            android:layout_height="55dp"
            android:hint="@string/plazo"
            android:inputType="textEmailAddress"
            android:textColor="@color/negro"
            android:textColorHint="@color/gris"
            android:textSize="16sp"/>


        <TextView
            android:layout_width="345dp"
            android:layout_height="match_parent"
            android:text="@string/campoTipo"
            android:textSize="18sp"
            android:textStyle="bold"
            android:fontFamily="@font/noto_serif_lao"
            android:layout_marginTop="10dp"
            android:textColor="@color/negro"/>

        <EditText
            android:id="@+id/campoTipo"
            style="@style/EditTextRounded"
            android:layout_width="345dp"
            android:layout_height="55dp"
            android:hint="@string/francesaAmericana"
            android:textColor="@color/negro"
            android:textColorHint="@color/gris"
            android:textSize="16sp"/>


        <Button
            android:id="@+id/buttonSaveCalculo"
            android:layout_width="200dp"
            android:layout_height="0dp"
            android:layout_marginTop="40dp"
            android:layout_weight="1"
            android:backgroundTint="@color/salmon"
            android:fontFamily="@font/noto_serif_lao"
            android:text="@string/guardar"
            android:textColor="@color/blanco"
            android:textSize="20sp"
            app:strokeColor="@color/blanco"
            app:strokeWidth="2dp" />

    </LinearLayout>

</ScrollView>